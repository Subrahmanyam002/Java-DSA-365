import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
    // Helper function to calculate GCD using Euclidean algorithm
    static int gcd(int a, int b) {
        if (b == 0)
            return a;
        return gcd(b, a % b);
    }

    public static void main (String[] args) throws java.lang.Exception
    {
        Scanner scanner = new Scanner(System.in);
        
        if (!scanner.hasNextInt()) return;
        int t = scanner.nextInt();
        
        while (t-- > 0) {
            int n = scanner.nextInt();
            int[] a = new int[n];
            
            for (int i = 0; i < n; i++) {
                a[i] = scanner.nextInt();
            }
            
            // Compute the GCD of the entire array
            int currentGcd = a[0];
            for (int i = 1; i < n; i++) {
                currentGcd = gcd(currentGcd, a[i]);
            }
            
            // If the GCD of the whole array is 1, 0 deletions are needed.
            // Otherwise, it's impossible to reach a GCD of 1.
            if (currentGcd == 1) {
                System.out.println(0);
            } else {
                System.out.println(-1);
            }
        }
        
        scanner.close();
    }
}
