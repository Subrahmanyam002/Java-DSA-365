import java.util.Scanner;

class Codechef {
    public static void main(String[] args) throws java.lang.Exception {
        Scanner scanner = new Scanner(System.in);
        
        if (!scanner.hasNextInt()) return;
        int t = scanner.nextInt();
        
        while (t-- > 0) {
            int n = scanner.nextInt();
            int[] a = new int[n];
            for (int i = 0; i < n; i++) {
                a[i] = scanner.nextInt();
            }
            
            int count5 = 0;
            int count10 = 0;
            boolean possible = true;
            
            for (int i = 0; i < n; i++) {
                int coin = a[i];
                
                if (coin == 5) {
                    count5++;
                } else if (coin == 10) {
                    if (count5 > 0) {
                        count5--;
                        count10++;
                    } else {
                        possible = false;
                        break;
                    }
                } else { // coin == 15
                    // Try to give Rs. 10 change first (Greedy approach)
                    if (count10 > 0) {
                        count10--;
                    } else if (count5 >= 2) {
                        count5 -= 2;
                    } else {
                        possible = false;
                        break;
                    }
                }
            }
            
            if (possible) {
                System.out.println("YES");
            } else {
                System.out.println("NO");
            }
        }
        
        scanner.close();
    }
}
