import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef {
    public static void main (String[] args) throws java.lang.Exception {
        Scanner sc = new Scanner(System.in);
        if (!sc.hasNextInt()) return;
        
        int t = sc.nextInt();
        while (t-- > 0) {
            String s = sc.next();
            // Use a HashSet to automatically handle duplicate country codes
            HashSet<String> uniqueCodes = new HashSet<>();
            
            // Extract all 2-letter contiguous substrings
            for (int i = 0; i < s.length() - 1; i++) {
                uniqueCodes.add(s.substring(i, i + 2));
            }
            
            // The size of the set gives the number of distinct country codes
            System.out.println(uniqueCodes.size());
        }
        sc.close();
    }
}
