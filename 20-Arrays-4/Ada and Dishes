import java.io.BufferedReader;
import java.io.InputStreamReader;
import java.io.IOException;
import java.util.StringTokenizer;

class Main {
    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        int t = Integer.parseInt(br.readLine().trim());

        StringBuilder sb = new StringBuilder();

        while (t-- > 0) {
            int n = Integer.parseInt(br.readLine().trim());
            int[] c = new int[n];
            int totalSum = 0;

            StringTokenizer st = new StringTokenizer(br.readLine());
            for (int i = 0; i < n; i++) {
                c[i] = Integer.parseInt(st.nextToken());
                totalSum += c[i];
            }

            int minTime = Integer.MAX_VALUE;

            // There are 2^n possible ways to distribute the dishes between the two burners
            int subsets = 1 << n;
            for (int i = 0; i < subsets; i++) {
                int burner1Time = 0;
                for (int j = 0; j < n; j++) {
                    // Check if the j-th dish is assigned to burner 1
                    if ((i & (1 << j)) != 0) {
                        burner1Time += c[j];
                    }
                }
                
                int burner2Time = totalSum - burner1Time;
                int currentMaxTime = Math.max(burner1Time, burner2Time);
                
                minTime = Math.min(minTime, currentMaxTime);
            }

            sb.append(minTime).append("\n");
        }
        System.out.print(sb);
    }
}
