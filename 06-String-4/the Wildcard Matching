import java.util.*;

class Codechef {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int T = sc.nextInt();

        while (T-- > 0) {

            String X = sc.next();
            String Y = sc.next();

            boolean possible = true;

            for (int i = 0; i < X.length(); i++) {

                if (X.charAt(i) != Y.charAt(i)
                    && X.charAt(i) != '?'
                    && Y.charAt(i) != '?') {

                    possible = false;
                    break;
                }
            }

            if (possible)
                System.out.println("Yes");
            else
                System.out.println("No");
        }
    }
}
