import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		// your code goes here
		Scanner sc = new Scanner(System.in);
		int t=sc.nextInt();
		while(t-->0){
		    String s = sc.next();
		    int n=s.length();
		    boolean lower=false;
		    boolean upper = false;
		    boolean digit=false;
		    boolean special=false;
		    for(int i=0;i<n;i++){
		        char ch=s.charAt(i);
		        if (ch>='a'&&ch<='z'){
		            lower = true;
		        } 
		        if(i!=0&&i!=n-1){
		            if(ch>='A'&&ch<='Z'){
		                upper=true;
		            }    
		        
		        if(ch>='0'&&ch<='9'){
		            digit=true;
		        }if(ch=='@' || ch=='#' || ch=='%' || ch=='&' || ch=='?')
		        special=true;
		    }
		}
		if(n>=10&&lower&&upper&&digit&&special)
            System.out.println("YES");
        else
            System.out.println("NO");
	}
}
}
