import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
    // Helper method to check if a character is a vowel
    static boolean isVowel(char c) {
        return c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u';
    }

    public static void main (String[] args) throws java.lang.Exception
    {
        Scanner sc = new Scanner(System.in);
        if (!sc.hasNextInt()) return;
        
        int t = sc.nextInt();
        long MOD = 1000000007;
        
        // Predefined list of vowels for distance calculation
        char[] vowels = {'a', 'e', 'i', 'o', 'u'};
        
        while (t-- > 0) {
            int n = sc.nextInt();
            String s = sc.next();
            
            long ans = 1;
            
            for (int i = 0; i < n; i++) {
                char ch = s.charAt(i);
                if (!isVowel(ch)) {
                    int minDist = 30;
                    int vowelCountWithMinDist = 0;
                    
                    // Find the minimum distance to any vowel
                    for (char v : vowels) {
                        int dist = Math.abs(ch - v);
                        if (dist < minDist) {
                            minDist = dist;
                            vowelCountWithMinDist = 1;
                        } else if (dist == minDist) {
                            vowelCountWithMinDist++;
                        }
                    }
                    
                    // If there are 2 vowels at the same minimum distance, multiply by 2
                    if (vowelCountWithMinDist == 2) {
                        ans = (ans * 2) % MOD;
                    }
                }
            }
            
            System.out.println(ans);
        }
        sc.close();
    }
}
