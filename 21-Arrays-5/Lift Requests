import java.io.BufferedReader;
import java.io.InputStreamReader;
import java.io.IOException;
import java.util.StringTokenizer;

class Codechef {
    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        StringTokenizer st = new StringTokenizer(br.readLine());
        
        int t = Integer.parseInt(st.nextToken());
        
        StringBuilder sb = new StringBuilder();
        
        while (t-- > 0) {
            st = new StringTokenizer(br.readLine());
            int n = Integer.parseInt(st.nextToken());
            int q = Integer.parseInt(st.nextToken());
            
            long totalFloors = 0;
            int currentFloor = 0;
            
            for (int i = 0; i < q; i++) {
                st = new StringTokenizer(br.readLine());
                int source = Integer.parseInt(st.nextToken());
                int dest = Integer.parseInt(st.nextToken());
                
                // Distance from current floor to source + source to destination
                totalFloors += Math.abs(source - currentFloor) + Math.abs(dest - source);
                
                // Update the current floor to the destination of the current request
                currentFloor = dest;
            }
            sb.append(totalFloors).append("\n");
        }
        System.out.print(sb);
    }
}
