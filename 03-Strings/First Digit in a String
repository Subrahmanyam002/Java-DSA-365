class Codechef {
    public static void main(String[] args) {
        // Define a string
        String text = "Version 2.0";

        // Find the index of the first occurrence of the digit '2'
        String indexOfDigit=text.indexOf('2');

        // Print the result
        System.out.println("The index of '2' is: " + indexOfDigit);

    }
}
