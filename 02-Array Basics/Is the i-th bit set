import java.util.*;
class Solution {
    public boolean isBitSet(long n, int i) {
        // write your code here 
        return (n & (1L<<i)) !=0;
    }
     public static void main (String[] args) {
        Scanner sc=new Scanner(System.in);
        int t=sc.nextInt();
        while(t-->0){
            long n=sc.nextInt();
            int i=sc.nextInt();
            Solution obj=new Solution();
            System.out.println(obj.isBitSet(n,i));
        }
      sc.close();
    }
}
